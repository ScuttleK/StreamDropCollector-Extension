{
  "manifest_version": 3,
  "name": "Stream Drop Collector Extension",
  "short_name": "Stream Drop Collector",
  "version": "3.1.0",
  "description": "Automatically claims Twitch channel point bonuses, Drops and Moments while you watch. Companion to the Stream Drop Collector app.",
  "author": "ScuttleK",
  "homepage_url": "https://github.com/ScuttleK/stream-drop-collector-extension",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Stream Drop Collector",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": ["https://www.twitch.tv/*"],
  "content_scripts": [
    {
      "matches": ["https://www.twitch.tv/*"],
      "js": ["src/page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.twitch.tv/*"],
      "js": ["src/content.js"],
      "run_at": "document_start"
    }
  ]
}
